---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  photos: ImageMetadata[];
  dayTitle: string;
  lang?: Lang;
}

const { photos, dayTitle, lang = 'en' } = Astro.props;
const s = t(lang);

// Pre-render a larger optimized variant of each photo for the lightbox.
const full = await Promise.all(
  photos.map((photo) => getImage({ src: photo, width: 1200, format: 'webp' })),
);
---

{
  photos.length > 0 && (
    <section class="mx-auto max-w-4xl px-4 mt-12">
      <h2 class="text-3xl mb-4">
        <span class="scribble">{s.photos}</span>
      </h2>
      <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
        {photos.map((photo, i) => (
          <button
            type="button"
            data-photo
            data-full={full[i].src}
            data-caption={`${dayTitle} — ${i + 1}`}
            class:list={[
              'sketch pop-sm lift overflow-hidden block cursor-zoom-in',
              'w-[calc(50%-0.375rem)] sm:w-[calc(33.333%-0.667rem)]',
              i % 2 === 1 ? 'rotate-1' : '-rotate-1',
            ]}
          >
            <Image
              src={photo}
              alt={`${dayTitle} — ${i + 1}`}
              widths={[240, 400, 600]}
              sizes="(max-width: 640px) 45vw, 240px"
              format="webp"
              loading="lazy"
              draggable={false}
              class="w-full aspect-square object-cover pointer-events-none"
            />
          </button>
        ))}
      </div>

      <dialog class="lightbox" data-lightbox>
        <form method="dialog" class="contents">
          <div class="lightbox-frame">
            <button
              data-close
              aria-label="Close"
              class="absolute -top-3 -right-3 z-10 w-10 h-10 rounded-full border-[2.5px] border-ink bg-cf text-paper text-lg font-hand pop-sm"
            >
              ✕
            </button>
            <img alt="" draggable="false" />
          </div>
        </form>
      </dialog>
    </section>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const img = dialog.querySelector('img');
    document
      .querySelectorAll<HTMLButtonElement>('[data-photo]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!img) return;
          img.src = btn.dataset.full ?? '';
          img.alt = btn.dataset.caption ?? '';
          dialog.showModal();
        });
      });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
