---
import type { Trip } from '../data/trips';
import { url } from '../lib/url';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const nights =
  Math.round(
    (new Date(trip.end).getTime() - new Date(trip.start).getTime()) / 86_400_000,
  );
---

<a class="trip-card" href={url(`/trips/${trip.slug}`)}>
  <div
    class="trip-card__cover"
    style={`background: linear-gradient(135deg, ${trip.gradient[0]}, ${trip.gradient[1]});`}
  >
    <span class="trip-card__country">{trip.country}</span>
    <span aria-hidden="true">{trip.emoji}</span>
  </div>
  <div class="trip-card__body">
    <h3>{trip.title}</h3>
    <span class="trip-card__dest">📍 {trip.destination}</span>
    <p class="trip-card__summary">{trip.summary}</p>
    <div class="trip-card__meta">
      <span>🗓️ {fmt(trip.start)} – {fmt(trip.end)}</span>
      <span>🌙 {nights} nights</span>
      <span>👥 {trip.travelers}</span>
      <span>💰 {trip.budget}</span>
    </div>
  </div>
</a>
