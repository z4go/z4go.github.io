---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const rotation = ['-rotate-2', 'rotate-1', 'rotate-2', '-rotate-1', 'rotate-1'];
---

{
  tags.length > 0 && (
    <section class="mx-auto max-w-4xl px-4 mt-12">
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag, i) => (
          <li class:list={['pill bg-cf-amber', rotation[i % rotation.length]]}>
            #{tag}
          </li>
        ))}
      </ul>
    </section>
  )
}
