---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const lang = 'en';
const s = t(lang);

const trips = (await getCollection('trips')).sort(
  (a, b) => a.data.startDate.getTime() - b.data.startDate.getTime(),
);

const allDays = await getCollection('days');
const daysOf = (tripId: string) =>
  allDays.filter((d) => d.id.startsWith(`${tripId}/`));

const tripPath = (e: CollectionEntry<'trips'>) => `/${e.id}/`;

const fmt = (date: Date, withYear = false) =>
  date.toLocaleDateString(s.locale, {
    day: 'numeric',
    month: 'short',
    ...(withYear ? { year: 'numeric' } : {}),
  });

const dateRange = (start: Date, end: Date) =>
  `${fmt(start)} – ${fmt(end, true)}`;

const statusLabel: Record<string, string> = {
  planning: '✎ Planning',
  live: '🟢 Live',
  done: '✓ Done',
};
const statusTint: Record<string, string> = {
  planning: 'bg-cf-amber',
  live: 'bg-leaf text-paper',
  done: 'bg-leaf text-paper',
};
---

<BaseLayout
  title="z4go — Trips"
  description="A hand-drawn collection of trip plans."
  lang={lang}
>
  <section class="mx-auto max-w-3xl px-4 pt-8 sm:pt-12">
    <p class="font-hand text-xl sm:text-2xl text-cf-dark rotate-[-1.5deg]">
      ✈ hand-drawn trip plans
    </p>
    <h1 class="text-4xl sm:text-6xl mt-1 leading-[1.05]">
      <span class="scribble">Trips</span>
    </h1>
    <p class="mt-3 max-w-xl text-sm sm:text-base text-ink-2">
      Day-by-day timelines, photos and the bookings still to make.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 mt-6 sm:mt-8">
    <ul class="flex flex-col gap-3 sm:gap-4">
      {
        trips.map((trip, i) => {
          const days = daysOf(trip.id);
          return (
            <li>
              <a
                href={tripPath(trip)}
                class:list={[
                  'sketch pop-sm lift overflow-hidden flex',
                  i % 2 === 0 ? 'sketch-alt' : '',
                ]}
              >
                <div class="shrink-0 w-24 sm:w-40 self-stretch border-r-2 border-ink overflow-hidden">
                  <Image
                    src={trip.data.cover}
                    alt={trip.data.coverAlt}
                    widths={[160, 240, 320, 480]}
                    sizes="(max-width: 640px) 96px, 160px"
                    format="webp"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-3 sm:p-4 flex flex-col flex-1 min-w-0 gap-1">
                  <div class="flex items-start gap-2">
                    <h2 class="text-xl sm:text-2xl leading-tight flex-1 min-w-0">
                      {trip.data.title}
                    </h2>
                    <span
                      class:list={[
                        'pill text-xs shrink-0',
                        statusTint[trip.data.status] ?? 'bg-cf-amber',
                      ]}
                    >
                      {statusLabel[trip.data.status] ?? trip.data.status}
                    </span>
                  </div>
                  <p class="font-hand text-base text-ink-2">
                    {dateRange(trip.data.startDate, trip.data.endDate)}
                  </p>
                  <p class="text-xs sm:text-sm text-ink-2 line-clamp-2">
                    {trip.data.summary}
                  </p>
                  <div class="mt-auto pt-1 flex items-center flex-wrap gap-1.5">
                    <span class="pill text-xs">📍 {trip.data.location}</span>
                    <span class="pill text-xs">📅 {days.length} days</span>
                    <span class="pill text-xs">👥 {trip.data.travellers}</span>
                    <span class="ml-auto font-hand text-sm sm:text-base text-cf-dark shrink-0">
                      Open →
                    </span>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>
